{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "eslint:check": "eslint --cache --cache-strategy content",
    "eslint:fix": "eslint --cache --cache-strategy content --fix",
    "code:check": "npm run eslint:check && npm run prettier:check",
    "code:fix": "npm run eslint:fix && npm run prettier:fix",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/fonts": "0.13.0",
    "@nuxt/icon": "2.2.1",
    "@tailwindcss/vite": "^4.2.4",
    "nuxt": "^4.3.0",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4"
  }
}
