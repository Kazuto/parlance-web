    "@thkzt/eunoia": "^0.0.1-beta.14",
    "@vueuse/core": "^14.3.0",
    "jwt-decode": "^4.0.0",
    "ky": "^2.0.2",
    "nuxt": "^4.3.0",
    "pinia": "^3.0.4",
    "qs": "^6.15.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
