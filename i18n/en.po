#. Help text under the profile picture in account settings, stating allowed image formats and maximum size.
msgid "account.avatarHelp"
msgstr "PNG, JPEG, WebP or GIF, up to 2 MB."

#. Error toast shown when the chosen profile picture has an unsupported type or is too large.
msgid "account.avatarInvalid"
msgstr "Choose a PNG, JPEG, WebP or GIF image of up to 2 MB."

#. Success toast shown after the user's profile picture was removed.
msgid "account.avatarRemoved"
msgstr "Your avatar is removed"

#. Success toast shown after a new profile picture was uploaded.
msgid "account.avatarSaved"
msgstr "Your avatar is saved"

#. Button in account settings that submits the password change form; shown when the user already has a password. Action, keep short.
msgid "account.changePassword"
msgstr "Change password"

#. Label of the input for the user's current password in the change-password form.
msgid "account.currentPassword"
msgstr "Current password"

#. Subtitle under the 'Your account' heading in account settings, describing what can be edited there.
msgid "account.description"
msgstr "Your name, email address, avatar and password. You can change them without any permission."

#. Label of the input for the new password in the change-password form.
msgid "account.newPassword"
msgstr "New password"

#. Hint in account settings shown to users who sign in via single sign-on and have no password yet.
msgid "account.noPassword"
msgstr "You sign in with single sign-on. Set a password to also sign in with your email address."

#. Page description (metadata subtitle) of the account page.
msgid "account.pageDescription"
msgstr "Your profile, password and interface language"

#. Success toast shown after the user changed their password.
msgid "account.passwordChanged"
msgstr "Your password is changed"

#. Validation error shown under the password form when the new password is empty.
msgid "account.passwordRequired"
msgstr "Enter a new password."

#. Error toast when saving the profile with an empty name or invalid email address.
msgid "account.profileRequired"
msgstr "Enter your name and a valid email address."

#. Button in account settings that removes the profile picture.
msgid "account.removeAvatar"
msgstr "Remove avatar"

#. Success toast shown after the user's name and email were saved.
msgid "account.saved"
msgstr "Your account is saved"

#. Button in account settings that sets a first password for users who sign in via single sign-on. Action, keep short.
msgid "account.setPassword"
msgstr "Set password"

#. Section heading in account settings for the user's own profile.
msgid "account.title"
msgstr "Your account"

#. Heading of the settings section where the user picks the interface language.
msgid "account.uiLanguage"
msgstr "User interface language"

#. Subtitle under the interface language heading explaining what the language setting changes.
msgid "account.uiLanguageDescription"
msgstr "Choose the language for menus, buttons and interface text"

#. Button in account settings that opens the file picker to upload a profile picture; also the screen-reader label of the hidden file input.
msgid "account.uploadAvatar"
msgstr "Upload avatar"

#. Sentence in the dashboard's recent activity feed. {user} is who acted, {subject} a count such as '3 translations', {where} the language phrase (e.g. 'in German'). Verb is past tense.
msgid "activity.added"
msgstr "{user} added {subject} {where}"

#. Sentence in the dashboard's recent activity feed. {user} is who acted, {subject} a count such as '3 translations', {where} the language phrase. Verb is past tense.
msgid "activity.approved"
msgstr "{user} approved {subject} {where}"

#. Sentence in the recent activity feed used when several kinds of changes happened at once. {user} is who acted, {subject} a count, {where} the language phrase.
msgid "activity.changed"
msgstr "{user} changed {subject} {where}"

#. Sentence in the dashboard's recent activity feed. {user} is who acted, {subject} a count such as '3 terms', {where} the language phrase. Verb is past tense.
msgid "activity.deleted"
msgstr "{user} deleted {subject} {where}"

#. Phrase in the recent activity feed filling {where} when one language is affected. {language} is the language name.
msgid "activity.inLanguage"
msgstr "in {language}"

#. Phrase in the recent activity feed filling {where} when several languages are affected. {count} is the number of languages.
msgid "activity.inLanguages"
msgstr "in {count} languages"

#. Error message in the dashboard's recent activity panel when loading the feed failed.
msgid "activity.loadFailed"
msgstr "Could not load recent activity."

#. Loading text in the dashboard's recent activity panel while the feed loads.
msgid "activity.loading"
msgstr "Loading activity…"

#. Empty state in the recent activity panel when the 'Only mine' filter is on and the user has no recent changes.
msgid "activity.noOwnActivity"
msgstr "You haven't changed any translations recently."

#. Label of a toggle in the recent activity panel that limits the feed to the current user's own activity.
msgid "activity.onlyMine"
msgstr "Only mine"

#. Sentence in the dashboard's recent activity feed. {user} is who acted, {subject} a count such as '3 translations', {where} the language phrase. Verb is past tense.
msgid "activity.rejected"
msgstr "{user} rejected {subject} {where}"

#. Fallback name shown in the recent activity feed when the acting user is unknown.
msgid "activity.someone"
msgstr "Someone"

#. Count of glossary terms, used as {subject} in activity sentences. Plural forms separated by |: one | other. {count} is the number of terms.
msgid "activity.terms"
msgstr "{count} term | {count} terms"

#. Count of translations, used as {subject} in activity sentences. Plural forms separated by |: one | other. {count} is the number of translations.
msgid "activity.translations"
msgstr "{count} translation | {count} translations"

#. Sentence in the dashboard's recent activity feed. {user} is who acted, {subject} a count such as '3 translations', {where} the language phrase. Verb is past tense.
msgid "activity.updated"
msgstr "{user} updated {subject} {where}"

#. Screen-reader label and tooltip for the icon button that copies the newly created API token to the clipboard.
msgid "apiTokens.copy"
msgstr "Copy token"

#. Warning shown in the token-created dialog, telling the user to copy the token because it is displayed only once.
msgid "apiTokens.copyNow"
msgstr "Copy the token now. It won't be shown again."

#. Button and dialog title for creating a new API token. Action.
msgid "apiTokens.create"
msgstr "Create token"

#. Small line in the API token list showing when the token was created. {time} is a relative or formatted date/time.
msgid "apiTokens.createdAt"
msgstr "Created {time}"

#. Dialog title shown after an API token was successfully created.
msgid "apiTokens.createdTitle"
msgstr "Token created"

#. Option in the token expiry dropdown. Plural forms separated by |: zero | one | many. {count} is the number of days until the token expires.
msgid "apiTokens.days"
msgstr "After {count} days | After {count} day | After {count} days"

#. Explanation under the 'API tokens' heading in account settings about what tokens are for and their limits.
msgid "apiTokens.description"
msgstr "Let scripts and CI use the API as you, with your permissions. A token can't manage tokens or change your password or email address."

#. Empty state text in the API token list when the user has no tokens.
msgid "apiTokens.empty"
msgstr "No tokens yet."

#. Small status badge in the API token list for a token that has expired. Status, not an action; keep short.
msgid "apiTokens.expired"
msgstr "Expired"

#. Label of the dropdown in the create-token dialog for choosing when the token expires.
msgid "apiTokens.expires"
msgstr "Expires"

#. Small line in the API token list showing when the token expires. {time} is a relative or formatted date/time.
msgid "apiTokens.expiresAt"
msgstr "Expires {time}"

#. Small line in the API token list showing when the token was last used. {time} is a relative or formatted date/time.
msgid "apiTokens.lastUsedAt"
msgstr "Last used {time}"

#. Helper text under the name input in the create-token dialog.
msgid "apiTokens.nameHelp"
msgstr "What uses the token, so you can tell it apart later"

#. Example placeholder in the token name input, naming a typical use such as a CI export job.
msgid "apiTokens.namePlaceholder"
msgstr "CI export"

#. Validation error in the create-token dialog when no name was entered.
msgid "apiTokens.nameRequired"
msgstr "Enter a name for the token"

#. Small line in the API token list for a token without an expiry date.
msgid "apiTokens.neverExpires"
msgstr "Never expires"

#. Small line in the API token list for a token that has not been used yet.
msgid "apiTokens.neverUsed"
msgstr "Never used"

#. Body text of the confirmation dialog for revoking an API token, explaining the consequence.
msgid "apiTokens.revokeConfirm"
msgstr "Scripts using this token stop working right away."

#. Screen-reader label for the trash icon button that revokes a token. {name} is the token's name.
msgid "apiTokens.revokeFor"
msgstr "Revoke {name}"

#. Title of the confirmation dialog for revoking an API token. {name} is the token's name.
msgid "apiTokens.revokeTitle"
msgstr "Revoke {name}?"

#. Success toast shown after an API token was revoked. {name} is the token's name.
msgid "apiTokens.revoked"
msgstr "Revoked {name}"

#. Section heading in account settings for API tokens.
msgid "apiTokens.title"
msgstr "API tokens"

#. Name of the application, shown as the heading on the login, setup and SSO callback pages. Usually kept untranslated.
msgid "app.name"
msgstr "Parlance"

#. Placeholder page title shown when a page has not set its own title.
msgid "app.pagePlaceholder"
msgstr "Placeholder. Please set a title in the page options."

#. Generic error message shown on the login page when signing in failed.
msgid "auth.loginFailed"
msgstr "Login failed"

#. Submit button on the login page.
msgid "auth.signIn"
msgstr "Sign in"

#. Subtitle on the login page above the form.
msgid "auth.signInPrompt"
msgstr "Sign in to your account"

#. Text of the login button while the sign-in request is running.
msgid "auth.signingIn"
msgstr "Signing in…"

#. Link or button on the single sign-on callback page that returns to the login page.
msgid "auth.sso.backToSignIn"
msgstr "Back to sign-in"

#. Error message on the single sign-on callback page when the identity provider returned without completing sign-in.
msgid "auth.sso.incomplete"
msgstr "The provider sent you back without signing you in. Start again."

#. Loading text on the login page while the user is being redirected to the single sign-on provider.
msgid "auth.sso.redirecting"
msgstr "Redirecting…"

#. Error message on the single sign-on callback page when the identity provider declined to sign the user in.
msgid "auth.sso.refused"
msgstr "The provider didn't sign you in."

#. Button on the login page that starts single sign-on. {name} is the provider's name.
msgid "auth.sso.signInWith"
msgstr "Sign in with {name}"

#. Loading text on the single sign-on callback page while the login is completed.
msgid "auth.sso.signingIn"
msgstr "Signing you in…"

#. Command palette entry that approves all draft translations of the open entry.
msgid "commands.approveAll"
msgstr "Approve all drafts"

#. Command palette entry, shown when no language field is focused, that copies the default-language text into the focused field.
msgid "commands.copySourceFocused"
msgstr "Copy default text into the focused field"

#. Command palette entry that copies the default-language text into the focused field. {language} is the name of that field's language.
msgid "commands.copySourceTo"
msgstr "Copy default text into {language}"

#. Command palette entry that moves the cursor to the entry search box. Action, not a heading.
msgid "commands.focusSearch"
msgstr "Search entries"

#. Group heading in the command palette above the list of entries to jump to.
msgid "commands.groupEntries"
msgstr "Go to entry"

#. Group heading in the command palette above commands that act on the currently open entry.
msgid "commands.groupEntry"
msgstr "This entry"

#. Group heading in the command palette above the commands that filter the entry list by status.
msgid "commands.groupFilter"
msgstr "Filter"

#. Group heading in the command palette above the list of app pages to navigate to.
msgid "commands.groupPages"
msgstr "Pages"

#. Command palette entry that opens the next entry in the list.
msgid "commands.nextEntry"
msgstr "Next entry"

#. Label of the small button hinting at the command palette, shown next to its keyboard shortcut. Keep short.
msgid "commands.open"
msgstr "Commands"

#. Command palette entry that opens the previous entry in the list.
msgid "commands.previousEntry"
msgstr "Previous entry"

#. Command palette entry that saves the current translations and opens the next entry.
msgid "commands.saveAndNext"
msgstr "Save and go to the next entry"

#. Command palette entry that filters the entry list by a translation status. {status} is the status name, e.g. Needs review.
msgid "commands.showStatus"
msgstr "Show: {status}"

#. Command palette entry that toggles the side panel with glossary, memory and history.
msgid "commands.toggleContext"
msgstr "Show or hide the context panel"

#. Generic label or placeholder meaning no language filter is applied, used in dropdowns and filter menus.
msgid "common.allLanguages"
msgstr "All languages"

#. Generic button label in dialogs and forms that applies edited settings.
msgid "common.applyChanges"
msgstr "Apply changes"

#. Generic button label that goes back to the previous step or page.
msgid "common.back"
msgstr "Back"

#. Generic button label in dialogs that dismisses without saving.
msgid "common.cancel"
msgstr "Cancel"

#. Generic button label that closes a dialog or panel.
msgid "common.close"
msgstr "Close"

#. Generic column header or form field label for a short identifier code, e.g. a locale code like 'en-US'.
msgid "common.code"
msgstr "Code"

#. Label of the password confirmation input in forms such as setup, account settings and user creation.
msgid "common.confirmPassword"
msgstr "Confirm password"

#. Short feedback text or tooltip shown briefly after something was copied to the clipboard.
msgid "common.copied"
msgstr "Copied"

#. Column header for the creation date in lists. Keep short.
msgid "common.created"
msgstr "Created"

#. Generic text of a submit button while an item is being created.
msgid "common.creating"
msgstr "Creating…"

#. Generic short badge, tooltip or column header marking the default item, e.g. the default language or default translation. Keep short.
msgid "common.default"
msgstr "Default"

#. Generic button label that deletes an item. Verb.
msgid "common.delete"
msgstr "Delete"

#. Phrase the user must type to confirm deleting an item in delete dialogs. {name} is the item's name.
msgid "common.deleteConfirmPhrase"
msgstr "Delete {name}"

#. Screen-reader label for a delete icon button. {name} is the name of the item to delete.
msgid "common.deleteFor"
msgstr "Delete {name}"

#. Generic column header or form field label for a free-text description.
msgid "common.description"
msgstr "Description"

#. Button in the unsaved changes dialog that throws away the changes. Verb.
msgid "common.discard"
msgstr "Discard"

#. Button that discards all unsaved edits in the editor. Verb.
msgid "common.discardAll"
msgstr "Discard all"

#. Body text of the confirmation dialog for discarding all unsaved changes. Plural forms separated by |: zero | one | other. {count} is the number of unsaved changes.
msgid "common.discardAllConfirm"
msgstr "{count} unsaved changes will be discarded, including changes outside the current selection. This can't be undone. | {count} unsaved change will be discarded, including changes outside the current selection. This can't be undone. | {count} unsaved changes will be discarded, including changes outside the current selection. This can't be undone."

#. Title of the confirmation dialog for discarding all unsaved changes.
msgid "common.discardAllTitle"
msgstr "Discard all changes?"

#. Generic button label that closes a dialog after finishing, e.g. after copying a new API token.
msgid "common.done"
msgstr "Done"

#. Generic button label or tooltip that opens an item for editing. Verb.
msgid "common.edit"
msgstr "Edit"

#. Screen-reader label for an edit icon button. {name} is the name of the item to edit.
msgid "common.editFor"
msgstr "Edit {name}"

#. Generic form field label and column header for an email address.
msgid "common.email"
msgstr "Email"

#. Label for the error details section, e.g. in the webhook delivery dialog.
msgid "common.error"
msgstr "Error"

#. Label, heading and screen-reader label of the filter popover button in the entry editor.
msgid "common.filters"
msgstr "Filters"

#. Form field label for a file or payload format dropdown, e.g. in import/export and webhook forms.
msgid "common.format"
msgstr "Format"

#. Suffix appended to the selected languages summary, noting that hidden languages are included. Starts with a space.
msgid "common.hiddenLanguages"
msgstr "(including hidden languages)"

#. Generic column header or form field label for an entry key (the identifier of a translatable string).
msgid "common.key"
msgstr "Key"

#. Toast shown after something was saved. {label} is the name of what was saved.
msgid "common.labelSaved"
msgstr "{label} saved"

#. Generic label or column header for a single language.
msgid "common.language"
msgstr "Language"

#. Count of languages shown in a locale detail view. {count} is the number of languages.
msgid "common.languageCount"
msgstr "{count} languages"

#. Generic label or heading for languages (plural noun).
msgid "common.languages"
msgstr "Languages"

#. Accessible name of the ⋯ menu button beside the save button under the editors on phones; the menu holds Discard all and Save all.
msgid "common.moreActions"
msgstr "More actions"

#. Generic column header or form field label for an item's name.
msgid "common.name"
msgstr "Name"

#. Validation error in webhook and translation server forms when the name or URL is missing or invalid.
msgid "common.nameUrlRequired"
msgstr "Enter a name and an http or https URL."

#. Option in the API token expiry dropdown meaning the token does not expire.
msgid "common.never"
msgstr "Never"

#. Short status label shown when a feature, provider or server is disabled. Keep short.
msgid "common.off"
msgstr "Off"

#. Short status label shown when a feature, provider or server is enabled. Keep short.
msgid "common.on"
msgstr "On"

#. Short link button on the dashboard cards that opens a section. Verb.
msgid "common.open"
msgstr "Open"

#. Separator word between alternatives, shown between the password form and single sign-on buttons on the login page.
msgid "common.or"
msgstr "or"

#. Generic form field label for a password.
msgid "common.password"
msgstr "Password"

#. Validation error shown when the password and its confirmation differ.
msgid "common.passwordMismatch"
msgstr "Passwords do not match."

#. Column header and form field label for the permissions of a role.
msgid "common.permissions"
msgstr "Permissions"

#. Text shown while a background job such as an import or export is running.
msgid "common.processing"
msgstr "Processing…"

#. Short status text in the editor shown when refreshing the data failed.
msgid "common.refreshFailed"
msgstr "Could not refresh."

#. Short status text in the editor shown while data is being refreshed.
msgid "common.refreshing"
msgstr "Refreshing…"

#. Checkbox or button label in webhook and SSO provider forms to delete the stored secret.
msgid "common.removeSavedSecret"
msgstr "Remove the saved secret"

#. Generic button label that retries a failed action. Verb.
msgid "common.retry"
msgstr "Retry"

#. Button label that undoes unsaved edits of a translation. Verb.
msgid "common.revert"
msgstr "Revert changes"

#. Screen-reader label for the icon button that reverts a translation's edits. {language} is the language name.
msgid "common.revertFor"
msgstr "Revert changes for {language}"

#. Generic button label that saves. Verb.
msgid "common.save"
msgstr "Save"

#. Button label in the editor that saves all unsaved translations. Verb.
msgid "common.saveAll"
msgstr "Save all"

#. Button label in the editor that saves all unsaved translations, with a count. {count} is the number of unsaved changes.
msgid "common.saveAllCount"
msgstr "Save all ({count})"

#. Generic button label in forms that saves edits. Verb.
msgid "common.saveChanges"
msgstr "Save changes"

#. Generic text of a save button while saving is in progress.
msgid "common.saving"
msgstr "Saving…"

#. Summary of selected languages in a language filter. Plural forms separated by |: zero | one | other. {count} is the number of selected languages.
msgid "common.selectedLanguages"
msgstr "{count} language selected | {count} language selected | {count} languages selected"

#. Text of a test or send button while a request is being sent, e.g. webhook test.
msgid "common.sending"
msgstr "Sending…"

#. Column header or label for a status.
msgid "common.status"
msgstr "Status"

#. Button in the bulk action bar that stops a running bulk operation. Verb.
msgid "common.stop"
msgstr "Stop"

#. Button label that tests a connection, e.g. of a translation server or SSO provider. Verb.
msgid "common.test"
msgstr "Test"

#. Message shown when a connection test failed. {error} is the error detail.
msgid "common.testFailed"
msgstr "Failed: {error}"

#. Text of a test button while the test is running.
msgid "common.testing"
msgstr "Testing…"

#. Generic button label that retries after an error. Verb.
msgid "common.tryAgain"
msgstr "Try again"

#. Screen-reader label for a switch that enables an item. {name} is the item's name.
msgid "common.turnOnFor"
msgstr "Turn on {name}"

#. Short badge in the editor and screen-reader hint marking a translation with unsaved edits. Keep short.
msgid "common.unsaved"
msgstr "Unsaved"

#. Short indicator of how many translations have unsaved edits. {count} is the number of unsaved changes.
msgid "common.unsavedCount"
msgstr "{count} unsaved"

#. Column header for the last-updated date in lists. Keep short.
msgid "common.updated"
msgstr "Updated"

#. Label in the history list for a change where a translation was approved. Past-tense status, not an action.
msgid "context.action.approved"
msgstr "Approved"

#. Label in the history list for a change where a translation was created. Past-tense status, not an action.
msgid "context.action.created"
msgstr "Created"

#. Label in the history list for a change where a translation was deleted. Past-tense status, not an action.
msgid "context.action.deleted"
msgstr "Deleted"

#. Label in the history list for a change where a translation draft was rejected by a reviewer. Past-tense status, not an action.
msgid "context.action.rejected"
msgstr "Rejected"

#. Label in the history list for a change where a translation was edited. Past-tense status, not an action.
msgid "context.action.updated"
msgstr "Updated"

#. Line in a history list item naming who made the change. {name} is the user's name or email.
msgid "context.changedBy"
msgstr "By {name}"

#. Screen-reader label and tooltip for the icon button that closes the context side panel.
msgid "context.close"
msgstr "Close context panel"

#. Hint in the glossary tab of the context panel, shown when no target language is selected.
msgid "context.defaultHint"
msgstr "Select a target language to see its preferred glossary wording."

#. Placeholder shown in place of text in history items, import previews and the source-change box when a translation or default text is empty.
msgid "context.emptyTranslation"
msgstr "Empty translation"

#. Tab title in the context panel for the change history. Keep short.
msgid "context.history"
msgstr "History"

#. Error shown in the context panel's history tab when loading the history failed. A retry button follows.
msgid "context.historyFailed"
msgstr "Could not load history."

#. Short explanation at the top of the history tab in the context panel.
msgid "context.historyHint"
msgstr "Entry history, filtered to this language on each page."

#. Loading message in the history tab of the context panel.
msgid "context.loadingHistory"
msgstr "Loading history…"

#. Tab title in the context panel for translation memory (similar texts translated before). Keep short.
msgid "context.memory"
msgstr "Memory"

#. Small badge on a translation memory match, shown when this exact translation is already used in the current field.
msgid "context.memoryAlreadyUsed"
msgstr "Already used here"

#. Hint in the memory tab of the context panel, shown when no target language is selected.
msgid "context.memoryDefaultHint"
msgstr "Select a target language to see how similar texts were translated."

#. Error shown in the memory tab when the translation memory search failed. A retry button follows.
msgid "context.memoryFailed"
msgstr "Could not search the translation memory."

#. Loading message in the memory tab while similar texts are searched.
msgid "context.memoryLoading"
msgstr "Looking for similar texts…"

#. Tooltip on the similarity percentage badge of a memory match. {language} is the default language's name.
msgid "context.memorySimilarity"
msgstr "How much of its {language} text matches this entry's"

#. Hint in the memory tab shown when the entry has no default-language text to search with.
msgid "context.memorySourceRequired"
msgstr "Add default-language text to find translations of similar texts."

#. Empty-state message in the history tab when there are no changes for the selected language on the current page.
msgid "context.noHistory"
msgstr "No changes for this language on this history page."

#. Empty-state message in the memory tab when no similar approved translations exist.
msgid "context.noMemory"
msgstr "No approved translations of similar texts yet."

#. Empty-state message in the glossary tab when no glossary terms match the text and language.
msgid "context.noTerms"
msgstr "No glossary matches for this text and language."

#. Screen-reader label and tooltip for the button in a translation row that opens the context panel. {language} is the row's language name.
msgid "context.openFor"
msgstr "Show context for {language}"

#. Small heading above the default text in the context panel. {language} is the default language's name.
msgid "context.source"
msgstr "Source · {language}"

#. Small label above the previous version of the default text in the source-change box. Keep short.
msgid "context.sourceBefore"
msgstr "Before"

#. Error in the source-change box when the earlier default text could not be loaded. A retry button follows.
msgid "context.sourceBeforeFailed"
msgstr "Could not load the earlier text."

#. Italic note in the source-change box when the default text was empty before the change.
msgid "context.sourceBeforeNone"
msgstr "There was no text before."

#. Heading and screen-reader label of the box showing the default text changed. {language} is the default language's name.
msgid "context.sourceChanged"
msgstr "The {language} text changed"

#. Hint in the source-change box telling the translator to review the translation after the default text changed.
msgid "context.sourceChangedHint"
msgstr "Check the translation still fits, then confirm or edit it."

#. Small label above the current version of the default text in the source-change box. Keep short.
msgid "context.sourceNow"
msgstr "Now"

#. Hint in the glossary tab shown when the entry has no default-language text to match terms against.
msgid "context.sourceRequired"
msgstr "Add default-language text to find matching glossary terms."

#. Name shown in a history item for changes made automatically, not by a person (e.g. a task or import).
msgid "context.systemUser"
msgstr "System"

#. Heading and screen-reader label of the context side panel next to the translation editor.
msgid "context.title"
msgstr "Translation context"

#. Name shown in a history item when the user who made the change no longer exists or can't be identified.
msgid "context.unknownUser"
msgstr "Unknown user"

#. Screen-reader label and tooltip for the icon button that inserts a translation memory match into the field.
msgid "context.useMatch"
msgstr "Use this translation"

#. Screen-reader label and tooltip for the icon button that restores an earlier translation from history into the field.
msgid "context.useVersion"
msgstr "Use this text"

#. Title of a dashboard stat card showing translations that await review.
msgid "dashboard.awaitingReview"
msgstr "Awaiting review"

#. Title of a dashboard stat card showing completed translations.
msgid "dashboard.completed"
msgstr "Completed"

#. Page description shown under the dashboard title.
msgid "dashboard.description"
msgstr "An overview of your translations, with quick access to every area"

#. Subtitle under the welcome greeting on the dashboard.
msgid "dashboard.greeting.description"
msgstr "Here's what you can do in Parlance today."

#. Welcome heading on the dashboard. {name} is the user's name.
msgid "dashboard.greeting.title"
msgstr "Welcome back, {name}!"

#. Heading of the dashboard panel showing translation progress for each language.
msgid "dashboard.languageProgress"
msgstr "Progress by language"

#. Description of the Locales quick access card on the dashboard.
msgid "dashboard.localesDescription"
msgstr "Manage languages and regional variants"

#. Message on the dashboard shown when the user has no permissions for any section.
msgid "dashboard.noAccess"
msgstr "You don't have permission to access any sections yet. Please contact your administrator."

#. Empty state of the recent activity panel when there is no activity.
msgid "dashboard.noActivity"
msgstr "No recent activity to display"

#. Legend label in the language progress panel. {count} is the number of approved translations.
