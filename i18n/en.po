#. Status badge for a delivery that failed. Not an action.
msgid "webhooks.status.WEBHOOK_DELIVERY_STATUS_FAILED"
msgstr "Failed"

#. Status badge for a delivery waiting to be sent. Not an action.
msgid "webhooks.status.WEBHOOK_DELIVERY_STATUS_PENDING"
msgstr "Pending"

#. Status badge for a delivery that was sent successfully. Not an action.
msgid "webhooks.status.WEBHOOK_DELIVERY_STATUS_SUCCEEDED"
msgstr "Delivered"

#. Status badge for a delivery with an unknown status.
msgid "webhooks.status.WEBHOOK_DELIVERY_STATUS_UNSPECIFIED"
msgstr "Unknown"

#. Button that sends a test delivery to the webhook's URL.
msgid "webhooks.test"
msgstr "Send test"

#. Toast shown after a test delivery succeeded. {status} is the HTTP status code and {ms} the response time in milliseconds.
msgid "webhooks.testOk"
msgstr "Delivered: {status} in {ms} ms"

#. Toast shown after a webhook was saved. {name} is the webhook's name.
msgid "webhooks.updated"
msgstr "Webhook {name} saved"

#. Label of the URL field in the webhook form.
msgid "webhooks.url"
msgstr "URL"

#. Helper text under the webhook URL field.
msgid "webhooks.urlHelp"
msgstr "Each event is posted here as JSON. Addresses in your own network work too."
